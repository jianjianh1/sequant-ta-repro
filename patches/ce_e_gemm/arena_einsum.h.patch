+/// [ce-e-fused] counters for the OWNING ce+e-GEMM path (SPTC_CE_E_GEMM); mirror
+/// of the [scale-fused] counters. Batched = per-cell GEMMs issued; fallback =
+/// non-uniform cells that reverted to the per-k rank-1 path.
+inline std::atomic<std::uint64_t> g_ce_e_owning_gemm{0}, g_ce_e_owning_fb{0};
+struct CeEOwningDumper {
+  ~CeEOwningDumper() {
+    if (g_ce_e_owning_gemm.load() || g_ce_e_owning_fb.load())
+      std::cerr << "[ce-e-fused] owning: batched-cell-GEMMs="
+                << g_ce_e_owning_gemm.load()
+                << " per-cell-fallbacks=" << g_ce_e_owning_fb.load() << "\n";
+  }
+};
+inline CeEOwningDumper g_ce_e_owning_dumper;
+
+/// OWNING-cell ce+e batched GEMM (SPTC_CE_E_GEMM) — op-488 coalescing. Same
+/// semantics as arena_strided_dgemm_ce_e (C[m,n](p,q) += factor * sum_k
+/// L[m,k](p) * R[k,n](q)), but owning inner cells are SEPARATE allocations (not
+/// an arena slab), so per result cell (m,n) it GATHERS L's and R's contracted-k
+/// runs into contiguous scratch [K×P]/[K×Q] and issues one GEMM
+/// C[P×Q] += factor * Lmat^T · Rmat, replacing K per-cell std::function
+/// dispatches. Non-uniform pairs fall back to the per-k rank-1 path.
+template <typename ResultOuter, typename LeftOuter, typename RightOuter>
+void arena_strided_dgemm_ce_e_owning(ResultOuter& C, const LeftOuter& L,
+                                     const RightOuter& R, std::size_t M,
+                                     std::size_t N, std::size_t K,
+                                     math::blas::Op left_op,
+                                     math::blas::Op right_op, double factor) {
+  namespace blas = TiledArray::math::blas;
+  using integer = blas::integer;
+  if (M == 0 || N == 0 || K == 0) return;
+  const std::size_t nbatch = static_cast<std::size_t>(C.nbatch());
+  if (nbatch == 0) return;
+  const bool shape_ok =
+      (C.range().volume() == M * N && L.range().volume() == M * K &&
+       R.range().volume() == K * N &&
+       static_cast<std::size_t>(L.nbatch()) == nbatch &&
+       static_cast<std::size_t>(R.nbatch()) == nbatch);
+  TA_ASSERT(shape_ok);
+  if (!shape_ok) return;
+  ScopedPhaseTimer _kernel_timer(g_kernel_ns_ce_e);
+  const std::size_t lda = (left_op == blas::NoTranspose) ? K : M;
+  const std::size_t ldb = (right_op == blas::NoTranspose) ? N : K;
+  auto a_off = [&](std::size_t m, std::size_t k) {
+    return (left_op == blas::NoTranspose) ? m * lda + k : k * lda + m;
+  };
+  auto b_off = [&](std::size_t k, std::size_t n) {
+    return (right_op == blas::NoTranspose) ? k * ldb + n : n * ldb + k;
+  };
+  const auto* lc = L.data();
+  const auto* rc = R.data();
+  auto* cc = C.data();
+  thread_local std::vector<double> Lmat, Rmat;  // gather scratch (per thread)
+  for (std::size_t b = 0; b < nbatch; ++b) {
+    const std::size_t cbase = b * M * N;
+    const std::size_t lbase = b * M * K;
+    const std::size_t rbase = b * K * N;
+    for (std::size_t m = 0; m < M; ++m) {
+      for (std::size_t n = 0; n < N; ++n) {
+        auto& Cc = cc[cbase + m * N + n];
+        if (TiledArray::empty(Cc)) continue;
+        // determine P (inner-left) and Q (inner-right) + uniformity over k
+        long P = -1, Q = -1;
+        bool uniform = true;
+        for (std::size_t k = 0; uniform && k < K; ++k) {
+          const auto& lk = lc[lbase + a_off(m, k)];
+          if (TiledArray::empty(lk)) continue;
+          const long p = static_cast<long>(lk.size());
+          if (P < 0) P = p; else if (p != P) uniform = false;
+        }
+        for (std::size_t k = 0; uniform && k < K; ++k) {
+          const auto& rk = rc[rbase + b_off(k, n)];
+          if (TiledArray::empty(rk)) continue;
+          const long q = static_cast<long>(rk.size());
+          if (Q < 0) Q = q; else if (q != Q) uniform = false;
+        }
+        if (P <= 0 || Q <= 0) continue;
+        if (uniform && static_cast<long>(Cc.size()) == P * Q) {
+          Lmat.assign(static_cast<std::size_t>(K) * P, 0.0);  // zero absent-k
+          Rmat.assign(static_cast<std::size_t>(K) * Q, 0.0);
+          for (std::size_t k = 0; k < K; ++k) {
+            const auto& lk = lc[lbase + a_off(m, k)];
+            if (!TiledArray::empty(lk)) std::copy_n(lk.data(), P, Lmat.data() + k * P);
+            const auto& rk = rc[rbase + b_off(k, n)];
+            if (!TiledArray::empty(rk)) std::copy_n(rk.data(), Q, Rmat.data() + k * Q);
+          }
+          {
+            ScopedShapedGemmTimer _gt(g_gemm_ns_ce_e, g_gemm_calls_ce_e,
+                                      g_ce_e_shapes, P, Q, K);
+            // C(P×Q) += factor * Lmat^T(P×K) · Rmat(K×Q); Lmat is [K×P] row-major
+            // (lda=P), Rmat [K×Q] (ldb=Q); Transpose,NoTranspose.
+            blas::gemm(blas::Transpose, blas::NoTranspose,
+                       static_cast<integer>(P), static_cast<integer>(Q),
+                       static_cast<integer>(K), factor, Lmat.data(),
+                       static_cast<integer>(P), Rmat.data(),
+                       static_cast<integer>(Q), /*beta=*/1.0, Cc.data(),
+                       static_cast<integer>(Q));
+          }
+          g_ce_e_owning_gemm.fetch_add(1, std::memory_order_relaxed);
+        } else {
+          g_ce_e_owning_fb.fetch_add(1, std::memory_order_relaxed);
+          double* c = Cc.data();
+          for (std::size_t k = 0; k < K; ++k) {
+            const auto& lk = lc[lbase + a_off(m, k)];
+            const auto& rk = rc[rbase + b_off(k, n)];
+            if (TiledArray::empty(lk) || TiledArray::empty(rk)) continue;
+            const std::size_t pp = lk.size(), qq = rk.size();
+            if (static_cast<long>(Cc.size()) != static_cast<long>(pp * qq))
+              continue;
+            const double* lp = lk.data();
+            const double* rp = rk.data();
+            for (std::size_t p = 0; p < pp; ++p)
+              for (std::size_t q = 0; q < qq; ++q)
+                c[p * qq + q] += factor * lp[p] * rp[q];
+          }
+        }
+      }
+    }
   }
 }
 
