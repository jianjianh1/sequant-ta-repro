+/// Env gate (SPTC_SCALE_GEMM=1) for the batched scale-GEMM path. Default off, so
+/// the per-cell fused_scale path is unchanged.
+inline bool scale_gemm_enabled() {
+  static const bool v = [] {
+    const char* e = std::getenv("SPTC_SCALE_GEMM");
+    return e && std::atoi(e) != 0;
+  }();
+  return v;
