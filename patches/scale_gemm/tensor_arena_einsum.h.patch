+/// Batched scale strided op (inner BROADCAST, outer contraction) — the MPQC
+/// per-pair GEMM form of the μ̃Κ half-transform (generated_t2:487). Computes
+///   C[m,n](a) += factor · Σ_k L[m,k] · R[k,n](a)
+/// where L is a FLAT tile of scalars ([M×K], no inner mode) and R,result are
+/// arena-view ToT (inner a). For each right-external n (an occupied pair),
+/// gathers R[k,n]'s inner a-vectors over the contracted k into a dense [K×Q]
+/// matrix and issues ONE GEMM  tmp[M×Q] = L[M×K]·Rmat[K×Q], then adds tmp rows
+/// into the result cells — replacing K·M per-cell scalar AXPYs with one GEMM per
+/// pair. A non-uniform-Q pair drops to the correct per-cell AXPY.
+template <typename ResultOuter, typename LeftFlat, typename RightOuter>
+void arena_strided_scale(ResultOuter& C, const LeftFlat& L, const RightOuter& R,
+                         std::size_t M, std::size_t N, std::size_t K,
+                         math::blas::Op left_op, math::blas::Op right_op,
+                         double factor) {
+  namespace blas = TiledArray::math::blas;
+  using integer = blas::integer;
+  static_assert(is_tensor_view_v<typename ResultOuter::value_type> &&
+                    is_tensor_view_v<typename RightOuter::value_type>,
+                "arena_strided_scale: result/right must be arena (view) ToT");
+  if (M == 0 || N == 0 || K == 0) return;
+  const std::size_t nbatch = static_cast<std::size_t>(C.nbatch());
+  if (nbatch == 0) return;
+  ScopedPhaseTimer _kernel_timer(g_kernel_ns_ce_e);
+  const double* Ld = L.data();  // FLAT: M*K doubles per batch, no inner cells
+  const auto* rc = R.data();
+  auto* cc = C.data();
+  const std::size_t lda = (left_op == blas::NoTranspose) ? K : M;
+  auto l_off = [&](std::size_t m, std::size_t k) {
+    return (left_op == blas::NoTranspose) ? m * lda + k : k * lda + m;
+  };
+  const std::size_t ldb_o = (right_op == blas::NoTranspose) ? N : K;
+  auto r_off = [&](std::size_t k, std::size_t n) {
+    return (right_op == blas::NoTranspose) ? k * ldb_o + n : n * ldb_o + k;
+  };
+  thread_local std::vector<double> Rmat, tmp;  // reused across calls (per thread)
+  for (std::size_t b = 0; b < nbatch; ++b) {
+    const std::size_t cbase = b * M * N;
+    const std::size_t lbase = b * M * K;
+    const std::size_t rbase = b * K * N;
+    for (std::size_t n = 0; n < N; ++n) {
+      long Q = -1;
+      bool uniform = true;
+      for (std::size_t k = 0; k < K; ++k) {
+        const auto& rk = rc[rbase + r_off(k, n)];
+        if (!rk) continue;
+        const long q = static_cast<long>(rk.size());
+        if (Q < 0)
+          Q = q;
+        else if (q != Q) {
+          uniform = false;
+          break;
+        }
+      }
+      if (Q <= 0) continue;  // no present operand cells for this pair
+      if (uniform) {
+        Rmat.assign(static_cast<std::size_t>(K) * Q, 0.0);  // zero absent-k rows
+        for (std::size_t k = 0; k < K; ++k) {
+          const auto& rk = rc[rbase + r_off(k, n)];
+          if (rk) std::copy_n(rk.data(), Q, Rmat.data() + k * Q);
+        }
+        tmp.resize(static_cast<std::size_t>(M) * Q);  // gemm beta=0 overwrites
+        {
+          ScopedShapedGemmTimer _gt(g_gemm_ns_ce_e, g_gemm_calls_ce_e,
+                                    g_ce_e_shapes, M, Q, K);
+          // L is a dense flat [M×K] (or [K×M]) tile: feed it straight to BLAS
+          // with its own orientation — no per-call copy.
+          blas::gemm(left_op, blas::NoTranspose, static_cast<integer>(M),
+                     static_cast<integer>(Q), static_cast<integer>(K), 1.0,
+                     Ld + lbase, static_cast<integer>(lda), Rmat.data(),
+                     static_cast<integer>(Q), 0.0, tmp.data(),
+                     static_cast<integer>(Q));
+        }
+        for (std::size_t m = 0; m < M; ++m) {
+          auto& Cc = cc[cbase + m * N + n];
+          if (!Cc || static_cast<long>(Cc.size()) != Q) continue;
+          double* c = Cc.data();
+          const double* t = tmp.data() + m * Q;
+          for (long a = 0; a < Q; ++a) c[a] += factor * t[a];
+        }
+      } else {
+        for (std::size_t m = 0; m < M; ++m) {
+          auto& Cc = cc[cbase + m * N + n];
+          if (!Cc) continue;
+          const long Ql = static_cast<long>(Cc.size());
+          double* c = Cc.data();
+          for (std::size_t k = 0; k < K; ++k) {
+            const auto& rk = rc[rbase + r_off(k, n)];
+            if (!rk || static_cast<long>(rk.size()) != Ql) continue;
+            const double s = factor * Ld[lbase + l_off(m, k)];
+            const double* rr = rk.data();
+            for (long a = 0; a < Ql; ++a) c[a] += s * rr[a];
+          }
+        }
+      }
+    }
+  }
+}
